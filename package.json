{
  "name": "rewind",
  "version": "1.0.0",
  "description": "A mobile-first PWA for podcast enthusiasts to rediscover older episodes",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:integration": "npm run test:integration --workspaces",
    "test:e2e": "npm run test:e2e --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:recommendation": "./tests/run-recommendation-tests.sh",
    "test:recommendation:unit": "./tests/run-recommendation-tests.sh unit",
    "test:recommendation:integration": "./tests/run-recommendation-tests.sh integration",
    "test:recommendation:e2e": "./tests/run-recommendation-tests.sh e2e",
    "test:recommendation:performance": "./tests/run-recommendation-tests.sh performance",
    "test:recommendation:watch": "npm run test:recommendation:unit -- --watch",
    "test:recommendation:coverage": "npm run test:coverage --workspaces -- --testPathPattern=recommendation",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "type-check": "npm run type-check --workspaces",
    "checks": "npm run lint && npm run format:check && npm run type-check && npm run test",
    "checks:recommendation": "npm run lint && npm run format:check && npm run type-check && npm run test:recommendation",
    "deploy": "./scripts/deploy.sh",
    "deploy:recommendation": "./scripts/deploy.sh --recommendation-only"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/rewind-cursor.git"
  },
  "keywords": [
    "podcast",
    "pwa",
    "react",
    "aws",
    "serverless",
    "recommendation-engine"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.25.74"
  }
}
