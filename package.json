{
  "name": "rewind",
  "version": "1.0.0",
  "description": "A mobile-first PWA for podcast enthusiasts to rediscover older episodes",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "test": "npm run test --workspaces",
    "deploy": "npm run deploy --workspace=infra",
    "storybook": "npm run storybook --workspace=frontend",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run lint && npm run format:check && npm run type-check && npm run test",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "localstack:start": "docker-compose -f docker-compose.localstack.yml --env-file .env.local up -d",
    "localstack:stop": "docker-compose -f docker-compose.localstack.yml down",
    "localstack:restart": "npm run localstack:stop && npm run localstack:start",
    "localstack:init": "./scripts/localstack-init.sh",
    "localstack:setup": "npm run localstack:start && sleep 10 && npm run localstack:init",
    "localstack:logs": "docker-compose -f docker-compose.localstack.yml logs -f",
    "localstack:reset": "npm run localstack:stop && docker volume rm rewind_localstack_volume || true && npm run localstack:setup",
    "localstack:test": "./scripts/test-localstack.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/rewind-cursor.git"
  },
  "keywords": [
    "podcast",
    "pwa",
    "react",
    "aws",
    "serverless",
    "recommendation-engine"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.25.74"
  }
}
